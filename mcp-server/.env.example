# Same Supabase project Reco's frontend uses.
SUPABASE_URL=

# Settings -> API -> service_role secret (Supabase dashboard). This bypasses
# Row Level Security, so it must ONLY ever live here (never in a VITE_-
# prefixed variable, which Vite bundles into client-side JS).
SUPABASE_SERVICE_ROLE_KEY=

# The remo-clone Railway deployment. Defaults to the production URL if unset.
RENDER_SERVICE_URL=https://remo-clone-production.up.railway.app

# Supabase Storage bucket that holds rendered clip videos. Must be created
# manually in the Supabase dashboard (Storage -> New bucket -> "motion-graphics",
# public) before the tools can upload anything.
MOTION_GRAPHICS_BUCKET=motion-graphics
